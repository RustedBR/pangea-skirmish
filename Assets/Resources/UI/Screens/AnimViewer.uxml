<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Theme/PangeaTheme.uss" />
    <ui:VisualElement name="root" class="pg-theme" style="flex-grow: 1; flex-direction: row; background-color: rgb(20, 28, 54); padding: 14px;">
        <ui:VisualElement name="left" class="pg-panel" style="width: 18%; margin-right: 1%;">
            <ui:Label text="ANIMAÇÕES" class="pg-title" />
            <ui:Label text="Ator" class="pg-section" />
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 8px;">
                <ui:Button name="actor-prev" text="&lt;" class="pg-button" style="width: 18%;" />
                <ui:Label name="actor-label" text="" class="pg-label" style="flex-grow: 1; -unity-text-align: middle-center; -unity-font-style: bold;" />
                <ui:Button name="actor-next" text="&gt;" class="pg-button" style="width: 18%;" />
            </ui:VisualElement>
            <ui:Label text="Animação" class="pg-section" />
            <ui:ScrollView name="clip-list" style="flex-grow: 1;" />
            <ui:Button name="btn-back" text="← Voltar" class="pg-button" style="margin-top: 8px;" />
        </ui:VisualElement>
        <ui:VisualElement name="center" class="pg-panel" style="flex-grow: 1; align-items: center;">
            <ui:VisualElement name="view" style="width: 62%; border-width: 2px; border-color: rgb(46, 42, 60);" />
            <ui:Label name="time-label" text="" class="pg-label" style="margin-top: 6px; -unity-font-style: bold;" />
            <ui:VisualElement name="views" style="flex-direction: row; margin-top: 6px;" />
            <ui:VisualElement name="speeds" style="flex-direction: row; margin-top: 6px;" />
            <ui:VisualElement style="flex-direction: row; margin-top: 6px;">
                <ui:Button name="btn-replay" text="↻ Tocar" class="pg-button pg-button--primary" style="width: 22%;" />
                <ui:Button name="btn-pause" text="Pausar" class="pg-button" style="width: 22%;" />
                <ui:Button name="btn-step" text="Quadro +" class="pg-button" style="width: 22%;" />
                <ui:Button name="btn-loop" text="Repetir: sim" class="pg-button" style="width: 26%;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="right" class="pg-panel" style="width: 20%; margin-left: 1%;">
            <ui:Label text="Suas notas" class="pg-section" />
            <ui:Label name="notes-for" text="" class="pg-label pg-label--dim" style="white-space: normal; margin-bottom: 4px;" />
            <ui:TextField name="notes" multiline="true" class="pg-input" style="flex-grow: 1; white-space: normal;" />
            <ui:Label name="notes-status" text="" class="pg-label pg-label--dim" style="white-space: normal; margin-top: 4px;" />
            <ui:Button name="btn-export" text="Salvar e copiar todas as notas" class="pg-button pg-button--primary" style="margin-top: 8px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
