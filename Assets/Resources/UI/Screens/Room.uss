/* Layout da tela de Sala/Lobby (visual base vem de PangeaTheme.uss). */

.room__root { flex-grow: 1; }

/* ---- Lobby ---- */
.room__center { flex-grow: 1; align-items: center; justify-content: center; }
.room__lobby { width: 460px; max-width: 94%; max-height: 96%; align-items: stretch; }
.room__profile-summary { color: rgb(205, 217, 235); font-size: 13px; -unity-text-align: middle-center; margin-bottom: 10px; white-space: normal; }
.room__section-gap { margin-top: 12px; }
.room__half-btn { flex-grow: 1; flex-basis: 0; }
.room__field { margin-top: 6px; margin-bottom: 6px; }
.room__field-label { margin-bottom: 2px; }
.room__or { -unity-text-align: middle-center; margin-top: 8px; margin-bottom: 6px; }
.room__loopback { margin-top: 10px; }
.room__status {
    -unity-text-align: middle-center;
    color: var(--pg-gold, rgb(255, 204, 85));
    min-height: 24px;
    margin-top: 8px;
    margin-bottom: 4px;
    white-space: normal;
}

/* ---- Sala ativa ---- */
.room__roomview { flex-grow: 1; padding: 12px; }

.room__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    padding: 8px 12px;
    flex-shrink: 0;
}
.room__header-left { flex-direction: row; align-items: center; }
.room__header-right { flex-direction: row; align-items: center; }
.room__header-title { font-size: 18px; -unity-font-style: bold; letter-spacing: 2px; color: var(--pg-text, rgb(238, 242, 255)); margin-right: 12px; }
.room__code-row { flex-direction: row; align-items: center; }
.room__code {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--pg-ok, rgb(90, 209, 138));
    margin-left: 8px;
    margin-right: 8px;
}
.room__copy-btn { padding-top: 4px; padding-bottom: 4px; padding-left: 10px; padding-right: 10px; }
.room__phase { color: rgb(159, 176, 208); font-size: 13px; }

.room__body { flex-grow: 1; flex-direction: row; }
.room__col { margin: 4px; }
/* Era 260px fixos: nome + "(host)" + time + botão Troca não cabiam e eram cortados. */
.room__col--players { width: 32%; min-width: 300px; max-width: 460px; flex-shrink: 0; }
.room__col--rules { width: 300px; flex-shrink: 0; }
.room__spacer { flex-grow: 1; }
.room__start-hint { color: rgb(90, 209, 138); font-size: 12px; -unity-text-align: middle-center; white-space: normal; margin-bottom: 4px; }
.room__start-hint--missing { color: rgb(255, 204, 85); }
.room__char { flex-shrink: 0; }
.room__char-row { flex-direction: row; align-items: center; }
.room__char-step { width: 34px; padding-left: 0; padding-right: 0; flex-shrink: 0; }
.room__char-name { flex-grow: 1; color: rgb(238, 242, 255); font-size: 15px; -unity-font-style: bold; -unity-text-align: middle-center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.room__char-info { color: rgb(159, 176, 208); font-size: 11px; white-space: normal; -unity-text-align: middle-center; margin-top: 4px; }
.room__player-char { color: rgb(159, 176, 208); font-size: 12px; flex-shrink: 1; min-width: 0; max-width: 40%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 6px; }
.room__player-char--missing { color: rgb(255, 204, 85); -unity-font-style: italic; }
.room__col--chat { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.room__col--host { width: 250px; }
.room__col-title {
    -unity-font-style: bold;
    color: var(--pg-text-dim, rgb(159, 176, 208));
    margin-bottom: 6px;
}
.room__scroll { flex-grow: 1; }

.room__chat-input-row { flex-direction: row; margin-top: 6px; }
.room__chat-input { flex-grow: 1; margin-right: 4px; }

.room__row { flex-direction: row; align-items: center; justify-content: center; }
.room__mode-btn { flex-grow: 1; flex-basis: 0; padding-left: 4px; padding-right: 4px; font-size: 13px; margin-left: 2px; margin-right: 2px; }
.room__mode-btn--active { background-color: var(--pg-ok, rgb(90, 209, 138)); color: rgb(8, 20, 12); }
.room__step-btn { width: 40px; }
.room__step-value { width: 60px; -unity-text-align: middle-center; color: var(--pg-text, rgb(238, 242, 255)); }
.room__ctrl-label { margin-top: 8px; margin-bottom: 2px; font-size: 12px; }
.room__advance { font-size: 16px; padding-top: 10px; padding-bottom: 10px; }


/* linha de jogador (criada em código) */
.room__player-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    padding-right: 4px;
}
/* O nome encolhe com reticências; time e botão nunca encolhem nem são cortados. */
.room__player-name {
    color: var(--pg-text, rgb(238, 242, 255));
    flex-grow: 1; flex-shrink: 1; min-width: 0;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    margin-right: 6px;
}
.room__player-team { flex-shrink: 0; white-space: nowrap; }
.room__swap-btn { padding-top: 2px; padding-bottom: 2px; padding-left: 8px; padding-right: 8px; margin-left: 6px; flex-shrink: 0; }

/* entrar por código */
.room__code-join-row { flex-direction: row; align-items: center; }
.room__code-input { flex-grow: 1; margin-right: 6px; }
.room__code-join-btn { flex-shrink: 0; }
.room__copy-feedback { color: var(--pg-ok, rgb(90, 209, 138)); margin-left: 8px; min-width: 70px; }

/* linha de chat (criada em código) */
.room__chat-line { color: var(--pg-text, rgb(238, 242, 255)); white-space: normal; padding-top: 1px; padding-bottom: 1px; }
.room__chat-line--system { color: var(--pg-text-dim, rgb(159, 176, 208)); -unity-font-style: italic; }

/* lista de salas (browser) */
.room__room-list { max-height: 220px; margin-top: 6px; }
.room__room-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: var(--pg-panel-bg-2, rgb(18, 26, 56));
    margin-bottom: 4px;
}
.room__room-row:hover { background-color: var(--pg-accent, rgb(106, 169, 255)); }
.room__room-name { color: var(--pg-text, rgb(238, 242, 255)); flex-grow: 1; font-size: 15px; }
.room__room-slots { color: var(--pg-text-dim, rgb(159, 176, 208)); margin-left: 8px; }
.room__refresh-btn { margin-top: 4px; align-self: stretch; }

/* edição de nome da sala (host) */

/* overlay de espera (não-host) */
.room__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
    align-items: center;
    justify-content: center;
}
.room__overlay-label {
    font-size: 22px;
    color: var(--pg-text, rgb(238, 242, 255));
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---- Abas (Chat / Room / Game) ---- */
.room__tabbar {
    flex-direction: row;
    margin-bottom: 8px;
    justify-content: flex-start;
}
.room__tab-btn { margin-left: 4px; padding-top: 5px; padding-bottom: 5px; }
.room__tabpanel {
    flex-grow: 1;
    flex-direction: row;
    margin-bottom: 8px;
}
.room__host-panel { flex-grow: 1; margin: 6px; }
.room__tuning-list { max-height: 420px; margin-bottom: 6px; }

/* Tooltip estilo BattleHUD (hover 400ms, flip/clamp) */
.room__tooltip {
    position: absolute;
    background-color: rgba(8, 12, 28, 0.96);
    border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgb(106, 169, 255); border-right-color: rgb(106, 169, 255); border-top-color: rgb(106, 169, 255); border-bottom-color: rgb(106, 169, 255);
    border-radius: 6px;
    padding: 6px 8px;
    max-width: 280px;
    white-space: normal;
}
.room__tooltip-txt {
    color: rgb(238, 242, 255);
    font-size: 12px;
    white-space: normal;
}

/* ---- Linha de campo do tuning (gerada por reflection) ---- */
.tuning__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 4px;
    padding-right: 4px;
    margin-bottom: 2px;
}
.tuning__label {
    color: var(--pg-text-dim, rgb(159, 176, 208));
    flex-grow: 1;
    font-size: 12px;
    white-space: normal;
    margin-right: 6px;
}
.tuning__value {
    color: var(--pg-text, rgb(238, 242, 255));
    font-size: 12px;
    min-width: 56px;
    -unity-text-align: middle-right;
    margin-right: 6px;
}
.tuning__slider { width: 120px; }
.tuning__input { width: 80px; }

/* ---- Layout horizontal canônico (stepper + label) — APROVADO 2026-07-12 ---- */
/* LINHA HORIZONTAL: label+hint à esquerda, stepper à direita */
.opt-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: var(--pg-panel-bg-2, rgb(18, 26, 56));
    border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgb(42, 58, 106);
    border-right-color: rgb(42, 58, 106);
    border-top-color: rgb(42, 58, 106);
    border-bottom-color: rgb(42, 58, 106);
    border-radius: 6px;
    padding: 6px 10px;
    margin-top: 8px;
}
.opt-text { flex-grow: 1; margin-right: 12px; }
.opt-label {
    color: var(--pg-text, rgb(238, 242, 255));
    font-size: 13px;
    flex-grow: 1;
}
.opt-desc {
    color: var(--pg-text-dim, rgb(159, 176, 208));
    font-size: 12px;
    margin-top: 2px;
    white-space: normal;
}

/* Stepper horizontal: [−] valor [+] */
.stepper { flex-direction: row; align-items: center; }
.step-btn {
    width: 30px;
    height: 28px;
    padding: 0;
    font-size: 16px;
    -unity-font-style: bold;
}
.step-value {
    min-width: 48px;
    height: 28px;
    -unity-text-align: middle-center;
    color: var(--pg-accent, rgb(106, 169, 255));
    font-size: 15px;
    -unity-font-style: bold;
    background-color: var(--pg-panel, rgb(10, 16, 38));
    border-top-width: 1px; border-top-color: var(--pg-accent, rgb(106, 169, 255));
    border-bottom-width: 1px; border-bottom-color: var(--pg-accent, rgb(106, 169, 255));
}

/* ---- Ícones BDragon (Opção C — steppers da aba Room, aprovados na imagem 2) ---- */
.room__icon { flex-shrink: 0; }
.room__icon--arrow {
    width: 12px;
    height: 12px;
    margin-left: 2px;
    margin-right: 2px;
}

/* ---- Scroller nativo estilizado (Opção A): cores BDragon no scrollbar ----
   Track azul translúcido, handle claro, setas < > com fundo azul.
   Não usa sprite de atlas (USS não carrega sub-sprite); replica o look BDragon. */
.room__scroll .unity-scroller--horizontal,
.room__scroll .unity-scroller--vertical {
    background-color: rgba(18, 26, 56, 0.6);
}
.room__scroll .unity-scroller__low-button,
.room__scroll .unity-scroller__high-button {
    background-color: var(--pg-accent, rgb(106, 169, 255));
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}
/* setas < > com cor escura sobre fundo azul (contraste) */
.room__scroll .unity-scroller__low-button:hover,
.room__scroll .unity-scroller__high-button:hover {
    background-color: var(--pg-panel-highlight, rgb(106, 134, 200));
}
.room__scroll .unity-scroller-slider {
    background-color: rgba(10, 16, 40, 0.9);
}
.room__scroll .unity-scroller-slider-handle {
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    min-width: 18px;
    min-height: 18px;
    background-color: transparent;
}
