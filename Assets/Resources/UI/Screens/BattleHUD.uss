/* BattleHUD — HUD reformulada (2026-11-10, mockup v4.1 aprovado).
   Tema FFT azul constante (PangeaTheme), texto dos botões centralizado.
   Layout novo: topbar + banda de intenção (topo), câmera/compasso (direita),
   mini-log + inspeção (sob demanda), barra de ticks (centro inf),
   painel de INTENÇÕES (direita), reação (modal central). */

.bh-root { flex-grow: 1; position: absolute; top: 0; left: 0; right: 0; bottom: 0; }

/* Janela base FFT (gradiente + cantos arredondados) */
.bh-window {
  background-color: rgb(22, 34, 66);
  border-radius: 8px;
  border-width: 1px; border-color: rgb(120, 160, 220); border-style: solid;
  padding: 6px;
}
.bh-title {
  font-size: 11px;
  color: rgb(189, 217, 255);
  -unity-font-style: bold;
  -unity-text-align: middle-center;
  background-color: rgb(41, 61, 117);
  border-radius: 4px;
  padding: 2px 4px;
  margin-bottom: 4px;
}

/* TOPO */
.bh-topbar {
  position: absolute; top: 10px; left: 0; right: 0; width: 357px; height: 51px;
  margin-left: auto; margin-right: auto;
  flex-direction: row; align-items: center; justify-content: space-between;
  padding: 0 14px;
}
.bh-phase { font-size: 15px; color: white; -unity-font-style: bold; flex-grow: 1; -unity-text-align: middle-center; }
.bh-timer { font-size: 17px; color: rgb(180, 230, 180); -unity-font-style: bold; -unity-text-align: middle-center; }

/* BANDA DE INTENÇÃO — faixa central no topo (NÃO cobre o botão Confirmar) */
.bh-intentband {
  position: absolute; top: 66px; left: 50%; width: 780px; min-height: 34px; translate: -50% 0;
  flex-direction: row; align-items: center; justify-content: center; gap: 8px;
  padding: 6px 16px; border-radius: 12px;
  display: none;
}
.bh-intent-tag  { font-size: 14px; margin-right: 10px; flex-shrink: 0; color: rgb(106, 169, 255); -unity-font-style: bold; -unity-text-align: middle-center; }
.bh-intent-hint { font-size: 14px; color: rgb(220, 228, 245); flex-grow: 1; flex-shrink: 1; -unity-text-align: middle-left; white-space: normal; }
.bh-intent-keys { flex-direction: row; gap: 4px; }
.bh-intent-key  {
  font-size: 11px; color: rgb(238, 242, 255); background-color: rgb(18, 26, 56);
  border-width: 1px; border-color: rgb(42, 58, 106); border-style: solid;
  border-radius: 4px; padding: 1px 5px; -unity-text-align: middle-center; min-width: 16px;
}

/* CAMERA MODE */
.bh-camera {
  position: absolute; top: 10px; right: 10px; width: 110px; height: 24px;
  align-items: center; justify-content: center; padding: 0;
}
.bh-camera-label { font-size: 11px; color: rgb(150, 200, 255); -unity-font-style: bold; }

/* COMPASSO — para onde aponta o norte do mapa na orientação de vista atual (Q/E).
   Fica logo abaixo do indicador de câmera (que termina em y=34), sem colidir. */
.bh-compass {
  position: absolute; top: 44px; right: 10px; width: 76px; height: 76px;
  align-items: center; justify-content: center; padding: 0;
}
.bh-compass-rose {
  position: relative; width: 60px; height: 60px;
  rotate: 0deg;
  transition-property: rotate;
  transition-duration: 0.29s;
  transition-timing-function: ease-out;
}
.bh-compass-dir {
  position: absolute; left: 50%; top: 50%; width: 18px; height: 16px;
  margin-left: -9px; margin-top: -8px;
  font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center;
  color: rgb(207, 230, 255);
  transition-property: rotate;
  transition-duration: 0.29s;
  transition-timing-function: ease-out;
}
.bh-compass-n { translate: 0 -24px; color: rgb(255, 120, 110); }
.bh-compass-s { translate: 0 24px; }
.bh-compass-e { translate: 24px 0; }
.bh-compass-w { translate: -24px 0; }
.bh-compass-needle {
  position: absolute; left: 50%; top: 50%;
  width: 2px; height: 14px; margin-left: -1px; margin-top: -14px;
  background-color: rgb(255, 120, 110);
}

/* MINI-LOG TEMPORÁRIO — histórico compacto, só com unidade selecionada */
.bh-minilog {
  position: absolute; left: 12px; bottom: 150px; width: 250px;
  flex-direction: column; display: none;
}
.bh-minilog-content { flex-direction: column; gap: 3px; }
.bh-minilog-content .bh-log-line { background-color: rgba(18, 26, 56, 0.5); border-radius: 4px; padding: 2px 5px; }
.bh-minilog-content .bh-log-line-text { font-size: 11px; -unity-text-align: middle-center; }
.bh-minilog-content .bh-round-hdr {
  background-color: rgb(26, 41, 87); border-radius: 4px; text-align: center;
  font-size: 10px; color: rgb(189, 217, 255); padding: 2px 4px; margin-top: 2px;
}
.bh-minilog-content .bh-round-hdr-text { font-size: 10px; color: rgb(189, 217, 255); -unity-text-align: middle-center; -unity-font-style: bold; }

/* INSPEÇÃO DA UNIDADE — bolha compacta sob demanda (some ao clicar fora).
   Fica embaixo dos painéis de ação: no UI Toolkit quem decide é a ORDEM dos elementos (é o
   primeiro filho da raiz; ver BattleHUD.Bind). z-index não existe no USS. */
.bh-inspect {
  position: absolute; left: 300px; top: 250px; width: 290px;
  padding: 10px; border-radius: 10px; border-color: rgb(106, 134, 200);
  box-shadow: 0 6px 18px rgba(0,0,0,0.5);
  display: none;
}
.bh-inspect-head { flex-direction: row; align-items: center; gap: 8px; margin-bottom: 6px; }
.bh-inspect-info { flex-grow: 1; }
.bh-portrait {
  width: 46px; height: 56px; background-color: rgb(10, 18, 41);
  border-width: 1px; border-color: rgb(120, 160, 220); border-style: solid; border-radius: 4px;
  flex-shrink: 0;
}
.bh-portrait-img { width: 100%; height: 100%; }
.bh-unit-name { font-size: 14px; color: white; -unity-font-style: bold; -unity-text-align: middle-center; }
.bh-hp-bg { width: 100%; height: 10px; background-color: rgb(10, 18, 41); border-radius: 4px; margin-top: 3px; }
.bh-hp-fill { width: 100%; height: 100%; background-color: rgb(90, 220, 120); border-radius: 4px; }
.bh-hp-text { font-size: 10px; color: rgb(205, 217, 235); -unity-text-align: middle-center; margin-top: 2px; }
.bh-ap-text { font-size: 11px; color: rgb(255, 230, 140); -unity-text-align: middle-center; }
.bh-stats-text { font-size: 10px; color: rgb(217, 224, 242); white-space: normal; -unity-text-align: middle-center; margin-top: 4px; line-height: 1.5; }

/* BARRA DE TICKS (GDD-016 §7) — track proporcional ao custo + chips da fila */
.bh-ticks {
  position: absolute; bottom: 12px; left: 50%; width: 780px; translate: -50% 0;
  flex-direction: column; align-items: stretch; display: none; padding: 6px 8px;
}
.bh-ticks-label { font-size: 11px; color: rgb(189, 217, 255); -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 4px; }
.bh-ticks-track { flex-direction: row; gap: 3px; align-items: stretch; height: 34px; }
.bh-tick {
  flex-grow: 1; border-radius: 4px; background-color: rgba(18, 26, 56, 0.85);
  border-width: 1px; border-color: rgb(42, 58, 106); border-style: solid;
  font-size: 11px; color: rgb(159, 176, 208); -unity-text-align: middle-center;
}
.bh-tick.used-move { background-color: rgb(74, 144, 226); border-color: rgb(74, 144, 226); color: #08103a; -unity-font-style: bold; }
.bh-tick.used-atk  { background-color: rgb(226, 87, 74); border-color: rgb(226, 87, 74); color: #fff; -unity-font-style: bold; }
.bh-tick.used-bonus{ background-color: rgb(255, 204, 85); border-color: rgb(255, 204, 85); color: #08103a; -unity-font-style: bold; }
.bh-tick.used-conc { background-color: rgb(150, 120, 255); border-color: rgb(150, 120, 255); color: #fff; -unity-font-style: bold; }
.bh-ticks-queue { flex-direction: row; gap: 4px; margin-top: 6px; justify-content: center; }
.bh-qact {
  flex-direction: row; align-items: center; justify-content: center; gap: 4px;
  padding: 4px 8px; border-radius: 5px;
  background-color: rgb(18, 26, 56); border-width: 1px; border-color: rgb(42, 58, 106); border-style: solid;
  font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.bh-qact-n {
  width: 15px; height: 15px; border-radius: 3px; background-color: rgb(10, 16, 40);
  color: rgb(238, 242, 255); font-size: 10px; -unity-text-align: middle-center;
}
.bh-qact.move  { color: rgb(210, 228, 255); } .bh-qact.move .bh-qact-n  { background-color: rgb(74, 144, 226); color: #08103a; }
.bh-qact.atk   { color: #ffe1de; }           .bh-qact.atk .bh-qact-n   { background-color: rgb(226, 87, 74); color: #fff; }
.bh-qact.bonus { color: #fff3cf; }           .bh-qact.bonus .bh-qact-n { background-color: rgb(255, 204, 85); color: #08103a; }
.bh-qact.conc  { color: #ece5ff; }           .bh-qact.conc .bh-qact-n  { background-color: rgb(150, 120, 255); color: #fff; }
.bh-qact-cost { font-size: 10px; color: rgb(159, 176, 208); }

/* Tooltip */
.bh-tooltip {
  position: absolute; left: 12px; top: 12px; width: 260px; min-height: 40px;
  padding: 6px; display: none;
}
.bh-tooltip-txt { font-size: 12px; color: rgb(235, 240, 255); white-space: normal; }

/* PAINEL DE INTENÇÕES — direita, substitui o menu cascata */
.bh-intents {
  position: absolute; right: 12px; bottom: 12px; width: 250px;
  flex-direction: column; gap: 5px;
}
.bh-intent-btn {
  margin: 0; padding: 0 6px; min-width: 0;
  height: 34px; border-radius: 6px; cursor: pointer;
  background-color: rgb(18, 26, 56);
  border-width: 1px; border-color: rgb(42, 58, 106); border-style: solid; border-top-color: rgb(106, 134, 200);
  color: rgb(238, 242, 255); font-size: 13px;
  -unity-text-align: middle-center;
}
.bh-intent-btn:hover { background-color: rgb(106, 169, 255); color: #08103a; }
.bh-intent-btn.armed { background-color: rgb(106, 169, 255); border-color: rgb(106, 169, 255); color: #08103a; -unity-font-style: bold; }
.bh-intent-dim { opacity: 0.45; }
.bh-intents-actions { flex-direction: row; gap: 5px; margin-top: 2px; }
.bh-actbtn {
  margin: 0; padding: 0 4px; min-width: 0; flex-shrink: 1; flex-basis: 0;
  flex-grow: 1; height: 32px; border-radius: 6px; border-width: 1px;
  border-color: rgb(42, 58, 106); border-style: solid;
  font-size: 12px; -unity-font-style: bold; cursor: pointer; -unity-text-align: middle-center;
}
.bh-act-confirm { background-color: rgb(106, 169, 255); border-color: rgb(106, 169, 255); color: #08103a; }
.bh-act-clear   { color: rgb(255, 90, 90); border-color: rgb(255, 90, 90); background-color: rgb(18, 26, 56); }

/* REACTION MENU — modal central (aprovado no mockup v4.1) */
.bh-reaction {
  position: absolute; left: 12px; bottom: 40px;   /* canto inferior esquerdo, acima do LOG (2026-11-13) */
  width: 420px; min-height: 140px;
  flex-direction: column; align-items: stretch; gap: 6px; padding: 14px;
  background-color: rgba(8, 12, 30, 0.97); border-color: rgb(106, 134, 200);
  display: none;
}
.bh-reaction-buttons { flex-direction: column; gap: 6px; align-self: stretch; }
.bh-reaction .pg-button { min-height: 44px; height: auto; font-size: 13px; -unity-text-align: middle-center; white-space: normal; }
.bh-bonus-timer { font-size: 15px; color: rgb(255, 140, 140); -unity-text-align: middle-center; }
.bh-prompt-text { font-size: 14px; color: rgb(255, 235, 153); white-space: normal; -unity-text-align: middle-center; flex-grow: 1; }

/* PROMPT DE BÔNUS (passos extras do GDD) */
.bh-prompt {
  position: absolute; right: 12px; bottom: 12px; width: 230px; height: 188px;
  flex-direction: column; align-items: center;
}
.bh-prompt-btn { height: 40px; width: 96px; border-radius: 6px; color: white; font-size: 16px; -unity-text-align: middle-center; margin: 4px; }
.bh-sim { background-color: rgb(41, 128, 56); }
.bh-nao { background-color: rgb(133, 41, 41); }

/* END */
.bh-end-panel {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0,0,0,0.55); align-items: center; justify-content: center;
  display: none;
}
.bh-end-win { width: 820px; height: 240px; align-items: center; justify-content: center; flex-direction: column; gap: 20px; }
.bh-end-text { font-size: 40px; color: white; -unity-text-align: middle-center; }
.bh-confirm-btn {
  height: 42px; background-color: rgb(36, 107, 56); color: white;
  border-radius: 6px; border-width: 1px; border-color: rgb(140, 217, 158); border-style: solid;
  font-size: 15px; -unity-text-align: middle-center; padding: 0 18px;
}

/* MP WAITING */
.bh-mp-waiting {
  position: absolute; bottom: 60px; left: 0; right: 0; margin-left: auto; margin-right: auto;
  width: 500px; height: 50px; align-items: center; justify-content: center;
  background-color: rgba(10,13,20,0.88); border-radius: 6px; display: none;
}
.bh-mp-waiting-text { font-size: 20px; color: rgb(235, 204, 89); -unity-text-align: middle-center; }

/* BARRA DE AÇÕES (GDD-020 §9) — ícones com tecla, acima da barra de ticks */
.bh-abar {
  position: absolute; left: 50%; bottom: 120px; translate: -50% 0;
  flex-direction: row; align-items: center; padding: 5px 6px; display: none;
}
.bh-abar-sep { width: 1px; height: 40px; background-color: rgb(74, 104, 170); margin: 0 5px; }
.bh-abtn {
  width: 54px; height: 50px; margin: 0 2px; padding: 0;
  background-color: rgb(26, 41, 87); border-radius: 6px;
  border-width: 1px; border-color: rgb(74, 104, 170); border-style: solid;
  align-items: center; justify-content: center;
}
.bh-abtn:hover { background-color: rgb(41, 61, 117); border-color: rgb(106, 169, 255); }
.bh-abtn--on { background-color: rgb(106, 169, 255); border-color: rgb(189, 217, 255); }
.bh-abtn--on .bh-abtn-glyph { color: rgb(8, 14, 34); }
.bh-abtn--on .bh-abtn-badge { color: rgb(8, 14, 34); }
.bh-abtn--off { opacity: 0.38; }
.bh-abtn-glyph { font-size: 20px; color: rgb(238, 242, 255); -unity-text-align: middle-center; -unity-font-style: bold; margin-top: -4px; }
.bh-abtn-key {
  position: absolute; top: 1px; left: 3px; font-size: 9px; color: rgb(159, 176, 208); -unity-font-style: bold;
}
.bh-abtn-badge {
  position: absolute; bottom: 1px; left: 0; right: 0; font-size: 9px; color: rgb(189, 217, 255);
  -unity-text-align: middle-center; white-space: nowrap; overflow: hidden;
}
.bh-abar-tip {
  position: absolute; left: 50%; bottom: 182px; translate: -50% 0; width: 360px;
  font-size: 12px; color: rgb(235, 240, 255); white-space: normal; padding: 6px 9px; display: none;
}
.bh-reaction-btn { white-space: normal; -unity-text-align: middle-left; font-size: 13px; padding: 7px 12px; margin: 2px 0; }
.bh-reaction .bh-prompt-text { white-space: normal; }

/* INSPEÇÃO COM ÍCONES (2026-11-13) */
.bh-inspect { width: 300px; }
.bh-itoggle {
  position: absolute; top: 6px; right: 8px; height: 18px; padding: 0 6px; margin: 0;
  font-size: 10px; color: rgb(189, 217, 255); background-color: rgb(26, 41, 87);
  border-width: 1px; border-color: rgb(74, 104, 170); border-radius: 4px;
}
.bh-itoggle:hover { border-color: rgb(106, 169, 255); }
.bh-ibar { flex-direction: row; align-items: center; margin-top: 3px; }
.bh-ibar-bg { flex-grow: 1; height: 8px; background-color: rgb(10, 18, 41); border-radius: 3px; margin: 0 6px; overflow: hidden; }
.bh-ibar-fill { height: 100%; border-radius: 3px; }
.bh-ibar-text { font-size: 11px; color: rgb(220, 228, 245); min-width: 44px; -unity-text-align: middle-right; }
.bh-igrid { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.bh-ichip {
  flex-direction: row; align-items: center; margin: 2px 4px 2px 0; padding: 2px 6px 2px 3px;
  background-color: rgba(10, 18, 41, 0.75); border-radius: 4px; border-width: 1px; border-color: rgb(42, 58, 106);
}
.bh-ichip:hover { border-color: rgb(106, 169, 255); }
.bh-ichip--state { border-color: rgb(120, 100, 180); }
.bh-ichip-icon { width: 16px; height: 16px; -unity-background-scale-mode: scale-to-fit; margin-right: 4px; }
.bh-ichip-text { font-size: 12px; color: rgb(238, 242, 255); -unity-font-style: bold; }
.bh-ihint { font-size: 11px; color: rgb(255, 214, 120); white-space: normal; margin-top: 4px; min-height: 0; }

/* PLACAS DE VIDA NA TELA (2026-11-13) — presas acima de cada unidade, tamanho fixo em pixels */
.up-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.up-plate {
  position: absolute; width: 132px; translate: -50% -100%; transform-origin: 50% 100%;
  padding: 3px 5px 4px 5px; border-radius: 5px;
  background-color: rgba(8, 12, 26, 0.86); border-width: 1px; border-color: rgb(74, 104, 170);
}
.up-plate--ally { border-color: rgb(90, 150, 240); }
.up-plate--enemy { border-color: rgb(220, 90, 80); }
.up-head { flex-direction: row; align-items: center; justify-content: center; margin-bottom: 2px; }
.up-name { font-size: 13px; color: rgb(238, 242, 255); -unity-font-style: bold; -unity-text-align: middle-center;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 108px; padding: 0; margin: 0; }
.up-icon { width: 16px; height: 16px; -unity-background-scale-mode: scale-to-fit; margin-right: 2px; flex-shrink: 0; }
.up-icon--small { width: 13px; height: 13px; }
.up-hprow { flex-direction: row; align-items: center; }
.up-hpbg { flex-grow: 1; height: 17px; background-color: rgb(20, 22, 30); border-radius: 3px; overflow: hidden;
  border-width: 1px; border-color: rgb(0, 0, 0); }
.up-hptrail { position: absolute; left: 0; top: 0; bottom: 0; background-color: rgb(255, 240, 200); }
.up-hpfill { position: absolute; left: 0; top: 0; bottom: 0; }
.up-hptext { position: absolute; left: 0; right: 0; top: 0; bottom: 0; font-size: 13px; color: rgb(255, 255, 255);
  -unity-font-style: bold; -unity-text-align: middle-center; -unity-text-outline-width: 1px;
  -unity-text-outline-color: rgb(0, 0, 0); padding: 0; margin: 0; }
.up-icons { position: absolute; left: 100%; top: -2px; flex-direction: row; margin-left: 4px; }
.up-row { flex-direction: row; align-items: center; margin-top: 2px; }
.up-barbg { flex-grow: 1; height: 7px; background-color: rgb(20, 22, 30); border-radius: 2px; overflow: hidden; margin: 0 3px; }
.up-mpfill { position: absolute; left: 0; top: 0; bottom: 0; background-color: rgb(80, 150, 255); }
.up-stfill { position: absolute; left: 0; top: 0; bottom: 0; background-color: rgb(255, 210, 80); }
.up-small { font-size: 11px; color: rgb(220, 228, 245); min-width: 12px; -unity-text-align: middle-right; padding: 0; margin: 0; }
.up-cast { height: 4px; margin-top: 3px; background-color: rgb(20, 22, 30); border-radius: 2px; overflow: hidden; }
.up-castfill { position: absolute; left: 0; top: 0; bottom: 0; }

.bh-abtn-icon { position: absolute; left: 50%; top: 6px; width: 22px; height: 22px; translate: -50% 0; -unity-background-scale-mode: scale-to-fit; }
.bh-intent-keys { display: none; }
.bh-itoggle { flex-direction: row; align-items: center; }
.bh-itoggle { padding: 0 6px 0 4px; height: 20px; }
.bh-itoggle-icon { width: 10px; height: 10px; margin-right: 3px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.bh-itoggle-text { font-size: 10px; color: rgb(189, 217, 255); padding: 0; margin: 0; -unity-text-align: middle-left; }
