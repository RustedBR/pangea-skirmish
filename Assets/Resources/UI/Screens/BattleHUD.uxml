<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
  <Style src="../Theme/PangeaTheme.uss" />
  <Style src="BattleHUD.uss" />
  <ui:VisualElement name="root" class="pg-theme bh-root" picking-mode="Ignore">

    <!-- TOPO: fase + timer (texto centralizado) -->
    <ui:VisualElement name="topbar" class="bh-window bh-topbar">
      <ui:Label name="phase-text" text="Phase" class="bh-phase" />
      <ui:Label name="timer-text" text="Timer" class="bh-timer" />
    </ui:VisualElement>

    <!-- BANDA DE INTENÇÃO (GDD-016): faixa central no topo, NÃO cobre mais o botão Confirmar.
         Substitui a dica de intenção que antes usava o prompt-panel de canto. -->
    <ui:VisualElement name="intent-band" class="bh-window bh-intentband">
      <ui:Label name="intent-tag" text="" class="bh-intent-tag" />
      <ui:Label name="intent-hint" text="" class="bh-intent-hint" />
      <ui:VisualElement class="bh-intent-keys">
        <ui:Label text="1" class="bh-intent-key" />
        <ui:Label text="2" class="bh-intent-key" />
        <ui:Label text="3" class="bh-intent-key" />
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- INDICADOR DE MODO CÂMERA -->
    <ui:VisualElement name="camera-mode" class="bh-window bh-camera">
      <ui:Label name="camera-mode-text" text="Auto" class="bh-camera-label" />
    </ui:VisualElement>

    <!-- COMPASSO -->
    <ui:VisualElement name="compass" class="bh-window bh-compass" picking-mode="Ignore">
      <ui:VisualElement name="compass-rose" class="bh-compass-rose" picking-mode="Ignore">
        <ui:VisualElement name="compass-needle" class="bh-compass-needle" picking-mode="Ignore" />
        <ui:Label name="compass-n" text="N" class="bh-compass-dir bh-compass-n" picking-mode="Ignore" />
        <ui:Label name="compass-e" text="L" class="bh-compass-dir bh-compass-e" picking-mode="Ignore" />
        <ui:Label name="compass-s" text="S" class="bh-compass-dir bh-compass-s" picking-mode="Ignore" />
        <ui:Label name="compass-w" text="O" class="bh-compass-dir bh-compass-w" picking-mode="Ignore" />
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- MINI-LOG TEMPORÁRIO (reformulação): histórico compacto que aparece junto com a
         inspeção da unidade selecionada — some quando não há seleção. Substitui o
         histórico fixo de batalha da esquerda. -->
    <ui:VisualElement name="mini-log" class="bh-window bh-minilog">
      <ui:Label text="HISTÓRICO" class="bh-title" />
      <ui:VisualElement name="mini-log-content" class="bh-minilog-content" />
    </ui:VisualElement>

    <!-- INSPEÇÃO DA UNIDADE (reformulação): bolha compacta sob demanda — aparece quando
         o jogador clica numa unidade e some ao clicar fora. Substitui o painel de status fixo. -->
    <ui:VisualElement name="inspect-panel" class="bh-window bh-inspect">
      <ui:VisualElement name="inspect-content" class="bh-inspect-content">
        <ui:VisualElement class="bh-inspect-head">
          <ui:VisualElement name="portrait" class="bh-portrait">
            <ui:Image name="portrait-img" class="bh-portrait-img" />
          </ui:VisualElement>
          <ui:VisualElement class="bh-inspect-info">
            <ui:Label name="unit-name" text="" class="bh-unit-name" />
            <ui:VisualElement name="hp-bg" class="bh-hp-bg">
              <ui:VisualElement name="hp-fill" class="bh-hp-fill" />
            </ui:VisualElement>
            <ui:Label name="hp-text" text="" class="bh-hp-text" />
            <ui:Label name="ap-text" text="" class="bh-ap-text" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="stats-text" text="" class="bh-stats-text" />
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- BARRA DE TICKS (GDD-016 §7): track proporcional ao custo + chips da fila.
         Substitui o seq-bar de chips fixos de 90px. -->
    <ui:VisualElement name="ticks-bar" class="bh-window bh-ticks">
      <ui:Label name="ticks-label" text="FILA — TEMPO" class="bh-ticks-label" />
      <ui:VisualElement name="ticks-track" class="bh-ticks-track" />
      <ui:VisualElement name="ticks-queue" class="bh-ticks-queue" />
    </ui:VisualElement>

    <!-- PAINEL DE INTENÇÕES (reformulação): substitui o menu cascata de comandos.
         1-3 armam intenção (mesmas teclas), 4-5 reservadas (dim). -->
    <ui:VisualElement name="intents-panel" class="bh-window bh-intents">
      <ui:Label text="INTENÇÕES" class="bh-title" />
      <ui:Button name="btn-intent-1" text="1 · Investir" class="bh-intent-btn" />
      <ui:Button name="btn-intent-2" text="2 · Golpear e recuar" class="bh-intent-btn" />
      <ui:Button name="btn-intent-3" text="3 · Recuar" class="bh-intent-btn" />
      <ui:Button name="btn-intent-4" text="4 · Manter distância" class="bh-intent-btn bh-intent-dim" />
      <ui:Button name="btn-intent-5" text="5 · Proteger" class="bh-intent-btn bh-intent-dim" />
      <ui:VisualElement name="intents-actions" class="bh-intents-actions">
        <ui:Button name="btn-confirm" text="Confirmar" class="bh-actbtn bh-act-confirm" />
        <ui:Button name="btn-undo" text="Desfazer" class="bh-actbtn" />
        <ui:Button name="btn-clear" text="Limpar" class="bh-actbtn bh-act-clear" />
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- REACTION MENU (modal central — não colide com mais nada) -->
    <ui:VisualElement name="reaction-menu" class="bh-window bh-reaction">
      <ui:Label name="reaction-title" text="REAGIR" class="bh-title" />
      <ui:Label name="reaction-timer" text="" class="bh-bonus-timer" />
      <ui:Label name="reaction-text" text="" class="bh-prompt-text" />
      <ui:VisualElement name="reaction-buttons" class="bh-reaction-buttons" />
    </ui:VisualElement>

    <!-- PROMPT DE BÔNUS (mantido p/ passos extras do GDD) -->
    <ui:VisualElement name="prompt-panel" class="bh-window bh-prompt">
      <ui:Label text="COMANDOS" class="bh-title" />
      <ui:Label name="bonus-timer" text="" class="bh-bonus-timer" />
      <ui:Label name="prompt-text" text="" class="bh-prompt-text" />
      <ui:Button name="btn-sim" text="Sim" class="bh-prompt-btn bh-sim" />
      <ui:Button name="btn-nao" text="Nao" class="bh-prompt-btn bh-nao" />
    </ui:VisualElement>

    <!-- TELA DE FIM -->
    <ui:VisualElement name="end-panel" class="bh-end-panel">
      <ui:VisualElement name="end-win" class="bh-window bh-end-win">
        <ui:Label name="end-text" text="" class="bh-end-text" />
        <ui:Button name="btn-end-menu" text="Voltar ao Menu" class="bh-confirm-btn" />
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- OVERLAY MULTIPLAYER: aguardando posicionamento -->
    <ui:VisualElement name="mp-waiting" class="bh-mp-waiting">
      <ui:Label name="mp-waiting-text" text="Aguardando jogadores posicionarem..." class="bh-mp-waiting-text" />
    </ui:VisualElement>

  </ui:VisualElement>
</ui:UXML>
