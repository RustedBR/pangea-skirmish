/* Layout da tela de Criação de Personagem.
   Cores/botões/inputs vêm de PangeaTheme.uss (.pg-*). Aqui só o layout específico. */

.cc-root { flex-grow: 1; }

/* Fundo full-screen que cobre a cena e captura cliques (equivalente ao dimmer do UGUI) */
.cc-dimmer {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(5, 8, 13, 0.92);
    align-items: center;
    justify-content: center;
}

/* Antes: 720px com min-height 640px, sem teto. Em janela baixa (navegador com barras) o
   painel passava da tela e o Confirmar ficava cortado embaixo. Agora o painel nunca passa
   de 96% da altura: o meio rola e o rodapé com os botões fica fixo. */
.cc-panel {
    width: 940px;
    max-width: 96%;
    max-height: 96%;
    padding: 16px 22px;
    align-items: stretch;
    flex-direction: column;
}
.cc-scroll { flex-grow: 1; flex-shrink: 1; min-height: 120px; }
.cc-footer { flex-shrink: 0; margin-top: 6px; }
.cc-footer-buttons { flex-direction: row; justify-content: center; }
.cc-footer-buttons .cc-confirm { margin-left: 8px; margin-right: 8px; margin-top: 4px; }

.cc-title { align-self: center; margin-bottom: 4px; }

.cc-budget {
    align-self: center;
    font-size: 16px;
    color: var(--pg-ok, rgb(90, 209, 138));
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.cc-budget-stepper {
    flex-direction: row;
    align-items: center;
    align-self: center;
    margin-bottom: 12px;
}
.cc-budget-stepper .cc-field-label { margin-bottom: 0; margin-right: 6px; }

/* Corpo: duas colunas (formulário + preview) */
.cc-body {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
}

.cc-form {
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 20px;
}

.cc-side {
    flex-direction: column;
    align-items: stretch;
    width: 330px;
    flex-shrink: 0;
    padding-top: 4px;
}

.cc-side-title {
    font-size: 14px;
    color: var(--pg-text-dim, rgb(159, 176, 208));
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.cc-sprite-preview {
    width: 230px;
    height: 230px;
    align-self: center;
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 10px;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-to-fit;
}
/* Ficha: números derivados do que está escolhido agora. */
.cc-derived {
    color: var(--pg-text, rgb(238, 242, 255));
    font-size: 13px;
    white-space: normal;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 8px;
    padding: 8px 10px;
    margin-bottom: 8px;
    height: 112px;
    overflow: hidden;
    flex-shrink: 0;
}
/* Explicação do que está sob o mouse (atributo, arma, aparência). */
.cc-info {
    color: var(--pg-gold, rgb(255, 204, 85));
    font-size: 13px;
    white-space: normal;
    /* Altura FIXA: o texto muda com o hover (a ajuda da arma é longa). Com altura livre o painel
       crescia, se deslocava, o botão saía de baixo do cursor e o texto voltava — o menu "saltava"
       e não dava para clicar nas setas da arma. */
    font-size: 12px;
    height: 176px;
    overflow: hidden;
    flex-shrink: 0;
    padding: 6px 10px;
}
.cc-weapon-info {
    color: var(--pg-text-dim, rgb(159, 176, 208));
    font-size: 12px;
    white-space: normal;
    margin-left: 96px;
    margin-bottom: 4px;
    height: 34px;          /* fixo: muda de tamanho a cada arma */
    overflow: hidden;
    flex-shrink: 0;
}
.cc-attr-row:hover, .cc-row:hover { background-color: rgba(106, 169, 255, 0.14); }

.cc-field { margin-bottom: 6px; }
.cc-field-label { margin-bottom: 2px; }
.cc-input { width: 100%; }

.cc-load {
    margin-left: 8px;
    width: 90px;
}

.cc-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    margin-bottom: 6px;
}
.cc-row-label { width: 90px; }

.cc-step {
    width: 40px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.cc-value {
    width: 120px;
    -unity-text-align: middle-center;
    color: var(--pg-text, rgb(238, 242, 255));
    margin-left: 6px;
    margin-right: 6px;
}
.cc-value--wide { width: 180px; }

/* Atributos em duas colunas: metade da altura. */
.cc-attrs { margin-top: 6px; margin-bottom: 4px; flex-direction: row; flex-wrap: wrap; }
.cc-attr-row {
    flex-direction: row;
    align-items: center;
    width: 50%;
    margin-top: 3px;
    margin-bottom: 3px;
    border-radius: 6px;
}
.cc-attr-label { width: 60px; }
.cc-step-value {
    width: 50px;
    -unity-text-align: middle-center;
    color: var(--pg-text, rgb(238, 242, 255));
    margin-left: 6px;
    margin-right: 6px;
}

.cc-status {
    align-self: center;
    min-height: 20px;
    margin-top: 2px;
    margin-bottom: 2px;
    color: var(--pg-danger, rgb(255, 102, 102));
    -unity-text-align: middle-center;
    white-space: normal;
}

.cc-confirm { align-self: center; width: 200px; margin-top: 8px; }
