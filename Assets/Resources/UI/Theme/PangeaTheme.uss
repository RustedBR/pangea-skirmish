/* ============================================================================
   PangeaTheme.uss — tema base da UI (UI Toolkit) do Pangea Skirmish.
   Variáveis de cor/tipografia + classes .pg-* reutilizáveis. Toda tela deve dar
   à sua raiz a classe "pg-theme" (o scaffolder já faz isso). As classes usam
   var(--x, fallback), então renderizam de forma sã mesmo sem o tema aplicado.
   Cores de elemento portadas de GameTuning (elem*Color).
   ============================================================================ */

.pg-theme {
    /* superfícies / painel estilo FFT (azul escuro translúcido) */
    /* mesmas superfícies da HUD de batalha (.bh-window / .bh-title) */
    --pg-panel-bg: rgb(20, 26, 24);
    --pg-panel-bg-2: rgb(34, 43, 40);
    --pg-panel-border: rgb(74, 86, 80);
    --pg-panel-highlight: rgb(58, 69, 64);
    --pg-chip-bg: rgb(42, 52, 48);

    /* texto */
    --pg-text: rgb(237, 230, 214);
    --pg-text-dim: rgb(185, 176, 156);

    /* acentos / estados */
    --pg-accent: rgb(242, 181, 68);   /* azul primário */
    --pg-on-ink: rgb(244, 234, 208);   /* texto sobre botão/faixa azul */
    --pg-inset: rgba(14, 18, 17, 0.6);
    --pg-gold: rgb(255, 204, 85);
    --pg-danger: rgb(255, 90, 90);
    --pg-ok: rgb(90, 209, 138);

    /* times */
    --pg-team-a: rgb(74, 144, 226);
    --pg-team-b: rgb(226, 87, 74);

    /* 6 elementos (de GameTuning) */
    --pg-elem-magic: rgb(128, 51, 255);
    --pg-elem-fire: rgb(255, 77, 0);
    --pg-elem-water: rgb(26, 102, 255);
    --pg-elem-air: rgb(179, 230, 255);
    --pg-elem-earth: rgb(128, 89, 38);
}

/* ---- Painel -------------------------------------------------------------- */
.pg-panel {
    background-color: var(--pg-panel-bg, rgb(20, 26, 24));
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--pg-panel-highlight, rgb(58, 69, 64));
    border-right-color: var(--pg-panel-highlight, rgb(58, 69, 64));
    border-top-color: var(--pg-panel-highlight, rgb(58, 69, 64));
    border-bottom-color: var(--pg-panel-highlight, rgb(58, 69, 64));
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding: 14px;
}

/* Faixa de título de seção, igual ao .bh-title da HUD de batalha. */
.pg-section {
    font-size: 12px;
    color: rgb(255, 214, 140);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: var(--pg-chip-bg, rgb(42, 52, 48));
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding: 3px 6px;
    margin-bottom: 8px;
}

/* Cartão interno (linha de lista, resumo) */
.pg-card {
    background-color: rgba(14, 18, 17, 0.75);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(46, 56, 51);
    border-right-color: rgb(46, 56, 51);
    border-top-color: rgb(46, 56, 51);
    border-bottom-color: rgb(46, 56, 51);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding: 8px 10px;
}

/* ---- Texto --------------------------------------------------------------- */
.pg-title {
    color: var(--pg-text, rgb(237, 230, 214));
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    margin-bottom: 8px;
}

.pg-subtitle {
    color: var(--pg-text-dim, rgb(185, 176, 156));
    font-size: 13px;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.pg-label {
    color: var(--pg-text, rgb(237, 230, 214));
    font-size: 13px;
}

.pg-label--dim {
    color: var(--pg-text-dim, rgb(185, 176, 156));
}

/* ---- Botão --------------------------------------------------------------- */
.pg-button {
    background-color: var(--pg-panel-bg-2, rgb(34, 43, 40));
    color: var(--pg-text, rgb(237, 230, 214));
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--pg-panel-border, rgb(74, 86, 80));
    border-right-color: var(--pg-panel-border, rgb(74, 86, 80));
    border-top-color: var(--pg-panel-border, rgb(74, 86, 80));
    border-bottom-color: var(--pg-panel-border, rgb(74, 86, 80));
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 7px;
    padding-bottom: 7px;
    margin: 3px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.08s;
}

.pg-button:hover {
    background-color: var(--pg-chip-bg, rgb(42, 52, 48));
    border-left-color: var(--pg-accent, rgb(242, 181, 68));
    border-right-color: var(--pg-accent, rgb(242, 181, 68));
    border-top-color: var(--pg-accent, rgb(242, 181, 68));
    border-bottom-color: var(--pg-accent, rgb(242, 181, 68));
}

.pg-button:active {
    scale: 0.97 0.97;
}

.pg-button:disabled {
    opacity: 0.45;
}

.pg-button--primary {
    background-color: var(--pg-accent, rgb(242, 181, 68));
    color: rgb(27, 20, 8);
    border-left-color: rgb(255, 214, 140);
    border-right-color: rgb(255, 214, 140);
    border-top-color: rgb(255, 214, 140);
    border-bottom-color: rgb(255, 214, 140);
}
.pg-button--primary:hover {
    background-color: rgb(255, 210, 122);
    color: rgb(27, 20, 8);
}

.pg-button--danger {
    color: rgb(255, 170, 165);
    border-top-color: rgb(150, 70, 80);
    border-bottom-color: rgb(150, 70, 80);
    border-left-color: rgb(150, 70, 80);
    border-right-color: rgb(150, 70, 80);
}
.pg-button--danger:hover {
    background-color: rgb(90, 36, 48);
    border-top-color: var(--pg-danger, rgb(255, 90, 90));
    border-bottom-color: var(--pg-danger, rgb(255, 90, 90));
    border-left-color: var(--pg-danger, rgb(255, 90, 90));
    border-right-color: var(--pg-danger, rgb(255, 90, 90));
}

/* ---- Campo de texto ------------------------------------------------------ */
.pg-input {
    background-color: rgba(0, 0, 0, 0.35);
    color: var(--pg-text, rgb(237, 230, 214));
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--pg-panel-border, rgb(46, 56, 51));
    border-right-color: var(--pg-panel-border, rgb(46, 56, 51));
    border-top-color: var(--pg-panel-border, rgb(46, 56, 51));
    border-bottom-color: var(--pg-panel-border, rgb(46, 56, 51));
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding: 6px;
}

/* O elemento editável interno do TextField é branco por padrão — deixa escuro no tema. */
.pg-theme .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0.35);
    color: var(--pg-text, rgb(237, 230, 214));
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}

/* ---- Listas (jogadores, chat) ------------------------------------------- */
.pg-list {
    background-color: rgba(14, 18, 17, 0.75);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding: 6px;
}

.pg-list-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 4px;
    padding-bottom: 4px;
}

/* ---- Chips / badges (time, elemento, host) ------------------------------ */
.pg-badge {
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.pg-badge--team-a { background-color: var(--pg-team-a, rgb(74, 144, 226)); }
.pg-badge--team-b { background-color: var(--pg-team-b, rgb(226, 87, 74)); }

/* utilitário */
.pg-hidden { display: none; }

/* ---- Slider (opções) ---------------------------------------------------- */
.pg-slider {
    width: 320px;
    margin-top: 4px;
    margin-bottom: 8px;
}
.pg-slider .unity-base-slider__tracker {
    background-color: var(--pg-accent, rgb(242, 181, 68));
}
.pg-slider .unity-base-slider__dragger {
    background-color: var(--pg-text, rgb(237, 230, 214));
}

/* ---- Dropdown (opções) ------------------------------------------------- */
.pg-dropdown {
    width: 320px;
    margin-top: 4px;
    margin-bottom: 8px;
    background-color: rgba(0, 0, 0, 0.35);
    color: var(--pg-text, rgb(237, 230, 214));
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--pg-panel-border, rgb(46, 56, 51));
    border-right-color: var(--pg-panel-border, rgb(46, 56, 51));
    border-top-color: var(--pg-panel-border, rgb(46, 56, 51));
    border-bottom-color: var(--pg-panel-border, rgb(46, 56, 51));
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding: 6px;
}

/* ---- Toggle (opções) --------------------------------------------------- */
.pg-toggle {
    margin-top: 4px;
    margin-bottom: 8px;
    color: var(--pg-text, rgb(237, 230, 214));
}
.pg-toggle .unity-toggle__checkmark {
    background-color: var(--pg-accent, rgb(242, 181, 68));
}


/* ============================================================================
   IDENTIDADE (GDD-025, 2026-11-14): pergaminho e tinta sobre o azul.
   - HUD de batalha e tudo que flutua sobre o jogo: azul (variáveis de .pg-theme).
   - Menus e fichas (.pg-panel): pergaminho. O painel redefine as variáveis --pg-*,
     então tudo dentro dele (texto, cartões, campos) muda de pele sem regra por tela.
   Texturas geradas por scripts/gen_ui.py.
   ============================================================================ */
.pg-panel, .bh-window {
    /* superfícies (grafite do redesign do tutorial, 2026-11-22) */
    --pg-panel-bg: rgb(20, 26, 24);
    --pg-panel-bg-2: rgb(34, 43, 40);
    --pg-chip-bg: rgb(42, 52, 48);
    --pg-panel-border: rgb(74, 86, 80);
    --pg-panel-highlight: rgb(58, 69, 64);
    --pg-inset: rgba(34, 43, 40, 0.9);
    /* texto */
    --pg-text: rgb(237, 230, 214);
    --pg-text-dim: rgb(185, 176, 156);
    --pg-on-ink: rgb(237, 230, 214);
    /* acentos */
    --pg-accent: rgb(242, 181, 68);
    --pg-gold: rgb(242, 181, 68);
    --pg-danger: rgb(224, 113, 74);
    --pg-ok: rgb(95, 178, 122);

    background-color: rgba(20, 26, 24, 0.94);
    border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgb(58, 69, 64); border-right-color: rgb(58, 69, 64);
    border-top-color: rgb(58, 69, 64); border-bottom-color: rgb(58, 69, 64);
    border-top-left-radius: 14px; border-top-right-radius: 14px;
    border-bottom-left-radius: 14px; border-bottom-right-radius: 14px;
}
.pg-panel { padding: 18px; }
.bh-window { padding: 10px; }

/* Faixa de seção: fita azul com letra creme (igual ao título das janelas da HUD). */
.pg-section, .pg-panel .pg-section, .bh-window .pg-section {
    background-color: rgb(42, 52, 48);
    color: rgb(244, 234, 208);
    letter-spacing: 1px;
}

/* Cartões, listas e campos: rebaixo no pergaminho. */
.pg-panel .pg-card, .bh-window .pg-card, .pg-panel .pg-list, .bh-window .pg-list {
    background-color: rgb(34, 43, 40);
    border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0;
    border-top-left-radius: 10px; border-top-right-radius: 10px;
    border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;
}
.pg-panel .pg-input, .bh-window .pg-input, .pg-panel .pg-dropdown, .bh-window .pg-dropdown, .pg-panel .unity-base-text-field__input, .bh-window .unity-base-text-field__input, .pg-panel .unity-base-popup-field__input, .bh-window .unity-base-popup-field__input {
    background-color: rgb(30, 37, 34);
    color: var(--pg-text);
    border-left-color: var(--pg-panel-border); border-right-color: var(--pg-panel-border);
    border-top-color: var(--pg-panel-border); border-bottom-color: var(--pg-panel-border);
}

/* Botões no pergaminho: selo azul, letra creme. */
.pg-panel .pg-button, .bh-window .pg-button {
    color: var(--pg-text); background-color: rgba(0, 0, 0, 0);
    border-left-color: rgb(74, 86, 80); border-right-color: rgb(74, 86, 80);
    border-top-color: rgb(74, 86, 80); border-bottom-color: rgb(74, 86, 80);
    border-top-left-radius: 10px; border-top-right-radius: 10px;
    border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;
}
.pg-panel .pg-button:hover, .bh-window .pg-button:hover { background-color: rgb(42, 52, 48); }
.pg-panel .pg-button:disabled, .bh-window .pg-button:disabled { opacity: 0.45; }
.pg-panel .pg-button--primary, .bh-window .pg-button--primary {
    background-color: var(--pg-accent); color: rgb(27, 20, 8);
    border-left-color: var(--pg-panel-highlight); border-right-color: var(--pg-panel-highlight);
    border-top-color: var(--pg-panel-highlight); border-bottom-color: var(--pg-panel-highlight);
}
.pg-panel .pg-button--primary:hover, .bh-window .pg-button--primary:hover { background-color: rgb(255, 210, 122); color: rgb(27, 20, 8); }
.pg-panel .pg-button--danger, .bh-window .pg-button--danger {
    background-color: rgb(120, 34, 38); color: var(--pg-on-ink);
    border-left-color: rgb(70, 20, 24); border-right-color: rgb(70, 20, 24);
    border-top-color: rgb(70, 20, 24); border-bottom-color: rgb(70, 20, 24);
}
.pg-panel .pg-button--danger:hover, .bh-window .pg-button--danger:hover { background-color: rgb(160, 46, 50); }
.pg-panel .pg-toggle, .bh-window .pg-toggle { color: var(--pg-text); }
